{
	"name": "@prozilla-os/dev-tools",
	"description": "A library of tools for the development of ProzillaOS packages.",
	"version": "1.1.17",
	"homepage": "https://os.prozilla.dev",
	"author": {
		"name": "Prozilla",
		"email": "business@prozilla.dev",
		"url": "https://prozilla.dev/"
	},
	"funding": "https://ko-fi.com/prozilla",
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"default": "./dist/main.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"default": "./dist/test.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./prompts": {
			"types": "./dist/prompts.d.ts",
			"default": "./dist/prompts.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && vite build",
		"test": "vitest",
		"lint": "pnpm eslint ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prozilla-os/ProzillaOS.git",
		"directory": "packages/dev-tools"
	},
	"license": "MIT",
	"dependencies": {
		"@inquirer/core": "^11.2.1",
		"@prozilla-os/core": "workspace:*",
		"@prozilla-os/shared": "workspace:*",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"magic-string": "^0.30.21",
		"vite": "^7.3.2",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.5"
	},
	"devDependencies": {
		"@types/node": "^20.19.39",
		"@types/react": "^18.3.28",
		"rollup": "^4.60.3",
		"typescript": "^5.9.3",
		"vite-plugin-externalize-deps": "^0.10.0"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
